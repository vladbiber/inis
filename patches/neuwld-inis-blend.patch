+static void
+renderer_copy_scaled(struct wld_renderer *base, struct buffer *buffer,
+                     double src_x, double src_y,
+                     double src_width, double src_height,
+                     int32_t dst_x, int32_t dst_y,
+                     uint32_t dst_width, uint32_t dst_height,
+                     pixman_region32_t *clip)
+{
+	struct pixman_renderer *renderer = pixman_renderer(base);
+	pixman_image_t *src = pixman_image(buffer), *dst = renderer->target;
+	pixman_transform_t transform;
+
+	if (!src) {
+		return;
+	}
+	if (dst_width == 0 || dst_height == 0 ||
+	    src_width <= 0.0 || src_height <= 0.0) {
+		pixman_image_unref(src);
+		return;
+	}
+
+	/* dst -> src mapping: src = src_origin + dst * (src_size / dst_size). */
+	memset(&transform, 0, sizeof(transform));
+	transform.matrix[0][0] = pixman_double_to_fixed(src_width / dst_width);
+	transform.matrix[1][1] = pixman_double_to_fixed(src_height / dst_height);
+	transform.matrix[0][2] = pixman_double_to_fixed(src_x);
+	transform.matrix[1][2] = pixman_double_to_fixed(src_y);
+	transform.matrix[2][2] = pixman_fixed_1;
+
+	pixman_image_set_transform(src, &transform);
+	pixman_image_set_filter(src, PIXMAN_FILTER_BILINEAR, NULL, 0);
+	if (clip) {
+		pixman_image_set_clip_region32(dst, clip);
+	}
+	/* OVER for the same blending reasons as renderer_copy_region. */
+	pixman_image_composite32(PIXMAN_OP_OVER, src, NULL, dst, 0, 0, 0, 0,
+	                         dst_x, dst_y, dst_width, dst_height);
+	if (clip) {
+		pixman_image_set_clip_region32(dst, NULL);
+	}
+	/* The pixman image is cached on the buffer — restore its defaults so
+	 * unscaled paths are unaffected. */
+	pixman_image_set_transform(src, NULL);
+	pixman_image_set_filter(src, PIXMAN_FILTER_NEAREST, NULL, 0);
+	pixman_image_unref(src);
+}
+
 void
 renderer_copy_region(struct wld_renderer *base, struct buffer *buffer,
                      int32_t dst_x, int32_t dst_y,
@@ -326,7 +374,18 @@ renderer_copy_region(struct wld_renderer *base, struct buffer *buffer,
 	pixman_region32_translate(&clip, dst_x, dst_y);
 
 	pixman_image_set_clip_region32(dst, &clip);
-	pixman_image_composite32(PIXMAN_OP_SRC, src, NULL, dst,
+	/*
+	 * Composite with OVER, not SRC: copy_region is the compositing path
+	 * (swc's repaint_view blends each surface onto the screen target).  A
+	 * plain SRC copy ignores the source alpha, so a translucent ARGB surface
+	 * overwrites the destination with its premultiplied pixels — fully
+	 * transparent areas (premultiplied 0,0,0,0) then show as solid black.
+	 * This is what made a Quickshell shell like noctalia paint a large black
+	 * rectangle from its full-screen translucent layer-shell overlays.  OVER
+	 * is also what upstream wld uses here.  Opaque buffers (XRGB, or ARGB
+	 * with alpha 0xff) are unaffected: OVER degenerates to SRC for them.
+	 */
+	pixman_image_composite32(PIXMAN_OP_OVER, src, NULL, dst,
 	                         region->extents.x1, region->extents.y1, 0, 0,
 	                         region->extents.x1 + dst_x,
 	                         region->extents.y1 + dst_y,
diff --git a/renderer.c b/renderer.c
