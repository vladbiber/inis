diff --git a/libswc/viewport.c b/libswc/viewport.c
new file mode 100644
index 0000000..a77b15b
--- /dev/null
+++ b/libswc/viewport.c
@@ -0,0 +1,204 @@
+/* swc: libswc/viewport.c
+ *
+ * wp_viewporter implementation: per-surface crop (source rectangle) and
+ * scale (destination size).  State lives in struct surface (double-buffered,
+ * latched on commit); the actual scaling happens in the compositor repaint
+ * path via wld_copy_scaled.
+ */
+
+#include "viewport.h"
+#include "internal.h"
+#include "surface.h"
+#include "util.h"
+
+#include <stdlib.h>
+#include <wayland-server.h>
+#include "viewporter-server-protocol.h"
+
+struct viewport {
+	struct wl_resource *resource;
+	struct surface *surface;
+	struct wl_listener surface_destroy_listener;
+};
+
+static void
+destroy_viewport_resource(struct wl_resource *resource)
+{
+	struct viewport *viewport = wl_resource_get_user_data(resource);
+
+	if (viewport->surface) {
+		/* Per spec, destroying the viewport removes crop/scale state;
+		 * it takes effect on the next commit. */
+		viewport->surface->viewport_pending.has_src = false;
+		viewport->surface->viewport_pending.has_dst = false;
+		viewport->surface->viewport_resource = NULL;
+		wl_list_remove(&viewport->surface_destroy_listener.link);
+	}
+	free(viewport);
+}
+
+static void
+handle_surface_destroy(struct wl_listener *listener, void *data)
+{
+	struct viewport *viewport =
+	    wl_container_of(listener, viewport, surface_destroy_listener);
+
+	(void)data;
+
+	/* The viewport object becomes inert. */
+	wl_list_remove(&viewport->surface_destroy_listener.link);
+	viewport->surface = NULL;
+}
+
+static void
+viewport_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	(void)client;
+	wl_resource_destroy(resource);
+}
+
+static void
+viewport_set_source(struct wl_client *client, struct wl_resource *resource,
+                    wl_fixed_t x, wl_fixed_t y,
+                    wl_fixed_t width, wl_fixed_t height)
+{
+	struct viewport *viewport = wl_resource_get_user_data(resource);
+	double dx = wl_fixed_to_double(x), dy = wl_fixed_to_double(y);
+	double dw = wl_fixed_to_double(width), dh = wl_fixed_to_double(height);
+
+	(void)client;
+
+	if (!viewport->surface) {
+		wl_resource_post_error(resource, WP_VIEWPORT_ERROR_NO_SURFACE,
+		                       "the wl_surface was destroyed");
+		return;
+	}
+
+	if (dw == -1.0 && dh == -1.0) {
+		viewport->surface->viewport_pending.has_src = false;
+		return;
+	}
+	if (dw <= 0.0 || dh <= 0.0 || dx < 0.0 || dy < 0.0) {
+		wl_resource_post_error(resource, WP_VIEWPORT_ERROR_BAD_VALUE,
+		                       "invalid source rectangle");
+		return;
+	}
+
+	viewport->surface->viewport_pending.has_src = true;
+	viewport->surface->viewport_pending.src_x = dx;
+	viewport->surface->viewport_pending.src_y = dy;
+	viewport->surface->viewport_pending.src_width = dw;
+	viewport->surface->viewport_pending.src_height = dh;
+}
+
+static void
+viewport_set_destination(struct wl_client *client,
+                         struct wl_resource *resource,
+                         int32_t width, int32_t height)
+{
+	struct viewport *viewport = wl_resource_get_user_data(resource);
+
+	(void)client;
+
+	if (!viewport->surface) {
+		wl_resource_post_error(resource, WP_VIEWPORT_ERROR_NO_SURFACE,
+		                       "the wl_surface was destroyed");
+		return;
+	}
+
+	if (width == -1 && height == -1) {
+		viewport->surface->viewport_pending.has_dst = false;
+		return;
+	}
+	if (width <= 0 || height <= 0) {
+		wl_resource_post_error(resource, WP_VIEWPORT_ERROR_BAD_VALUE,
+		                       "invalid destination size");
+		return;
+	}
+
+	viewport->surface->viewport_pending.has_dst = true;
+	viewport->surface->viewport_pending.dst_width = width;
+	viewport->surface->viewport_pending.dst_height = height;
+}
+
+static const struct wp_viewport_interface viewport_impl = {
+	.destroy = viewport_destroy,
+	.set_source = viewport_set_source,
+	.set_destination = viewport_set_destination,
+};
+
+/* wp_viewporter */
+
+static void
+viewporter_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	(void)client;
+	wl_resource_destroy(resource);
+}
+
+static void
+viewporter_get_viewport(struct wl_client *client, struct wl_resource *resource,
+                        uint32_t id, struct wl_resource *surface_resource)
+{
+	struct surface *surface = wl_resource_get_user_data(surface_resource);
+	struct viewport *viewport;
+
+	if (surface->viewport_resource) {
+		wl_resource_post_error(resource,
+		                       WP_VIEWPORTER_ERROR_VIEWPORT_EXISTS,
+		                       "surface already has a viewport");
+		return;
+	}
+
+	viewport = calloc(1, sizeof(*viewport));
+	if (!viewport) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+
+	viewport->resource =
+	    wl_resource_create(client, &wp_viewport_interface,
+	                       wl_resource_get_version(resource), id);
+	if (!viewport->resource) {
+		free(viewport);
+		wl_client_post_no_memory(client);
+		return;
+	}
+
+	viewport->surface = surface;
+	viewport->surface_destroy_listener.notify = handle_surface_destroy;
+	wl_resource_add_destroy_listener(surface->resource,
+	                                 &viewport->surface_destroy_listener);
+	surface->viewport_resource = viewport->resource;
+	wl_resource_set_implementation(viewport->resource, &viewport_impl,
+	                               viewport, &destroy_viewport_resource);
+}
+
+static const struct wp_viewporter_interface viewporter_impl = {
+	.destroy = viewporter_destroy,
+	.get_viewport = viewporter_get_viewport,
+};
+
+static void
+bind_viewporter(struct wl_client *client, void *data, uint32_t version,
+                uint32_t id)
+{
+	struct wl_resource *resource;
+
+	(void)data;
+
+	resource = wl_resource_create(client, &wp_viewporter_interface,
+	                              version, id);
+	if (!resource) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	wl_resource_set_implementation(resource, &viewporter_impl, NULL, NULL);
+}
+
+struct wl_global *
+viewporter_create(struct wl_display *display)
+{
+	return wl_global_create(display, &wp_viewporter_interface, 1, NULL,
+	                        &bind_viewporter);
+}
